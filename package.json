{
  "name": "clean-code-todo",
  "version": "1.0.0",
  "private": true,
  "description": "Clean Code refactoring exercise",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "lint-staged": {
    "*.js": "eslint --max-warnings=0",
    "*": "prettier --check --ignore-unknown"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.10"
  }
}
